<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_model_view_form" model="ir.ui.view">
        <field name="name">ir.model.view.form</field>
        <field name="model">ir.model</field>
        <field name="inherit_id" ref="base.view_model_form" />
        <field name="arch" type="xml">
            <field name="modules" position="after">
                <field name="use_custom_sequences" invisible="1" />
                <field
                    name="sequence_code_field_id"
                    options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"
                    invisible="not use_custom_sequences"
                />
                <button
                    string="Set sequence code where it is missing"
                    type="object"
                    name="set_missing_sequence_code"
                    invisible="not use_custom_sequences or not sequence_code_field_id"
                />
            </field>
        </field>
    </record>
</odoo>
