<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_project_display" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.project_display</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="project.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//app[@name='project']" position="inside">
                    <div class="app_settings_block" data-string="Display" string="Display">
                        <h2>Project Display</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <field name="ir_model_project_project" invisible="1"/>
                                <label for="project_project_display_name_pattern" string="Project Name Pattern"/>
                                <div class="o_setting_right_pane">
                                    <field name="project_project_display_name_pattern" class="w-100"/>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <field name="ir_model_project_task" invisible="1"/>
                                <label for="project_task_display_name_pattern" string="Task Name Pattern"/>
                                <div class="o_setting_right_pane">
                                    <field name="project_task_display_name_pattern" class="w-100"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
