<data>
    <record id="project_project_view_form" model="ir.ui.view">
        <field name="name">project.project.view.form.unique_code</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]//h1" position="after">
                <div name="unique_code">
                    <div>
                        <label
                            for="unique_code"
                            class="oe_inline"
                            string="Sequence code:"
                        />
                        <field
                            name="unique_code"
                            class="oe_inline oe_input_align"
                            readonly="1"
                        />
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="project_project_view_tree" model="ir.ui.view">
        <field name="name">project.project.view.tree.unique_code</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="unique_code" optional="hide" />
            </xpath>
        </field>
    </record>
    <record id="project_project_view_kanban" model="ir.ui.view">
        <field name="name">project.project.view.kanban.unique_code</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="name" />
            </xpath>
            <xpath
                expr="//span[@t-att-title='record.display_name.value']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//span[@t-att-title='record.display_name.value']"
                position="after"
            >
                <span>
                    <t t-esc="record.display_name.value" />
                </span>
            </xpath>
        </field>
    </record>
</data>
