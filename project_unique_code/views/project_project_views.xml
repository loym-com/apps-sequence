<data>
    <record id="project_project_view_form" model="ir.ui.view">
        <field name="name">project.project.view.form.unique_code</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <h1 position="before">
                <div class="d-flex h3">
                    <!-- <label for="unique_code" string="No." /> -->
                    <field name="unique_code" decoration-bf="1" readonly="1" />
                </div>
            </h1>
        </field>
    </record>
    <record id="project_project_view_tree" model="ir.ui.view">
        <field name="name">project.project.view.tree.unique_code</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="unique_code" optional="hide" />
            </xpath>
        </field>
    </record>
    <record id="project_project_view_kanban" model="ir.ui.view">
        <field name="name">project.project.view.kanban.unique_code</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_project_kanban_main')]" position="before">
                <div class="d-flex flex-column">
                    <div class="d-flex mb-0 h3">
                        <field name="unique_code" string="Product No." decoration-bf="1" readonly="1"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="name" />
            </xpath>
            <xpath
                expr="//span[@t-att-title='record.display_name.value']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//span[@t-att-title='record.display_name.value']"
                position="after"
            >
                <span>
                    <t t-esc="record.display_name.value" />
                </span>
            </xpath>
        </field>
    </record>
</data>
