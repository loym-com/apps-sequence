<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_product_view_tree" model="ir.ui.view">
        <field name="name">product.product.view.tree.inherit.unique_code</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view" />
        <field name="arch" type="xml">
            <field name="default_code" position="before">
                <field
                    name="unique_code"
                    optional="show"
                    string="Product No."
                />
            </field>
        </field>
    </record>
    <record id="product_product_view_search" model="ir.ui.view">
        <field name="name">product.product.view.search.inherit.unique_code</field>
        <field name="model">product.product</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="product.product_search_form_view" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field
                    name="unique_code"
                    string="Product No."
                    filter_domain="[('unique_code', 'ilike', self)]"
                />
            </field>
        </field>
    </record>
    <record id="product_product_view_kanban" model="ir.ui.view">
        <field name="name">product.product.view.kanban.inherit.unique_code</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_kanban_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('d-flex', 'mb-1', 'h5')]" position="before">
                <div class="d-flex mb-0 h3">
                    <field name="unique_code" string="Product No." decoration-bf="1" readonly="1" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
