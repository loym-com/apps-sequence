<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_view_tree" model="ir.ui.view">
        <field name="name">product.template.view.tree.inherit.unique_code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field
                    name="unique_code"
                    optional="hide"
                    string="Product No."
                />
            </field>
        </field>
    </record>
    <record id="product_template_view_search" model="ir.ui.view">
        <field name="name">product.template.view.search.inherit.unique_code</field>
        <field name="model">product.template</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <!-- Add search field for Product Template Number -->
            <field name="name" position="after">
                <field
                    name="unique_code"
                    string="Product Template No."
                    filter_domain="[('unique_code', 'ilike', self)]"
                />
            </field>
        </field>
    </record>
    <record id="product_template_view_form" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.unique_code</field>
        <field name="model">product.template</field>
        <!-- <field name="inherit_id" ref="product.product_template_only_form_view" /> -->
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <label for="name" position="replace"/>
            <h1 position="before">
                <div class="d-flex h3">
                    <!-- <label for="unique_code" string="No." /> -->
                    <field name="unique_code" decoration-bf="1" readonly="1" />
                </div>
            </h1>
        </field>
    </record>
    <record id="product_template_view_kanban" model="ir.ui.view">
        <field name="name">product.template.view.kanban.inherit.unique_code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@class='d-flex mb-0 h5']" position="before">
                <div class="d-flex mb-0 h3">
                    <field name="unique_code" string="Product No." decoration-bf="1" readonly="1" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
