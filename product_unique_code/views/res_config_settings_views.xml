<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_product_display" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.product_display</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="project.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//app[@name='account']" position="inside">
                    <div class="app_settings_block" data-string="Display" string="Display">
                        <h2>Product Template and Variant Display</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <field name="ir_model_product_template" invisible="1"/>
                                <label for="product_template_display_name_pattern" string="Template Name Pattern"/>
                                <field name="product_template_display_name_pattern" class="w-100"/>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <field name="ir_model_product_product" invisible="1"/>
                                <label for="product_product_display_name_pattern" string="Variant Name Pattern"/>
                                <field name="product_product_display_name_pattern" class="w-100"/>
                            </div>

                            <div class="col-12 col-lg-6 o_setting_box">
                                <field name="ir_model_product_template" invisible="1"/>
                                <label for="product_template_unique_code_pattern" string="Template Number Pattern"/>
                                <field name="product_template_unique_code_pattern" class="w-100" readonly="product_template_unique_code_from_variant"/>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <field name="ir_model_product_product" invisible="1"/>
                                <label for="product_product_unique_code_pattern" string="Variant Number Pattern"/>
                                <field name="product_product_unique_code_pattern" class="w-100"/>
                            </div>

                            <div class="col-12 col-lg-6 o_setting_box">
                                <field name="ir_model_product_template" invisible="1"/>
                                <label for="product_template_unique_code_sequence_id" string="Template Sequence"/>
                                <field name="product_template_unique_code_sequence_id" class="w-100"/>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <field name="ir_model_product_product" invisible="1"/>
                                <label for="product_product_unique_code_sequence_id" string="Variant Sequence"/>
                                <field name="product_product_unique_code_sequence_id" class="w-100"/>
                            </div>

                            <div class="col-12 col-lg-6 o_setting_box">
                                <label for="product_template_unique_code_from_variant" string="Get Template Number From Variant"/>
                                <div class="o_setting_left_pane">
                                    <field name="product_template_unique_code_from_variant" class="w-100" readonly="product_template_unique_code_pattern"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
