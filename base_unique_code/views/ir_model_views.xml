<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_model_view_form" model="ir.ui.view">
        <field name="name">ir.model.view.form</field>
        <field name="model">ir.model</field>
        <field name="inherit_id" ref="base.view_model_form" />
        <field name="arch" type="xml">
            <field name="display_name_pattern" position="after">
                <field name="unique_code_pattern" placeholder="{id:>05} or {_sequence_}" invisible="not unique_code_field_exists"/>
                <field name="unique_code_sequence_id" invisible="not unique_code_field_exists"/>
            </field>
        </field>
    </record>
</odoo>
