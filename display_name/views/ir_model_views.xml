<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_model_view_form" model="ir.ui.view">
        <field name="name">ir.model.view.form.dispay_name_pattern</field>
        <field name="model">ir.model</field>
        <field name="inherit_id" ref="base.view_model_form" />
        <field name="arch" type="xml">
            <field name="modules" position="after">
                <field name="use_custom_display_name" invisible="1" />
                <field
                    name="display_name_pattern"
                    placeholder="{id:>05} - {name}"
                    invisible="not use_custom_display_name"
                />
                <field
                    name="display_code_pattern"
                    placeholder="{id:>05}"
                    invisible="not use_custom_display_name"
                />
                <button
                    string="Set display_code where it is missing"
                    type="object"
                    name="set_missing_stored_display_code"
                />
            </field>
        </field>
    </record>
</odoo>
