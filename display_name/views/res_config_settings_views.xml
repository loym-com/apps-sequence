<data>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">Custom display_name</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='user_default_rights']" position="inside">
                <setting id="use_custom_display_name">
                    <field name="use_custom_display_name" />
                    <div class="content-group" invisible="not use_custom_display_name">
                        <div class="mt8">
                            <button
                                type="action"
                                name="%(base.action_model_model)s"
                                string="Manage Display Name on Models"
                                icon="oi-arrow-right"
                                class="btn-link"
                            />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</data>
