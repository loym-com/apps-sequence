<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_model_view_form" model="ir.ui.view">
        <field name="name">ir.model.view.form</field>
        <field name="model">ir.model</field>
        <field name="inherit_id" ref="base.view_model_form" />
        <field name="arch" type="xml">
            <data>
                <field name="unique_code_sequence_id" position="attributes">
                    <attribute name="invisible">sequence_choice_field_id</attribute>
                </field>
                <field name="unique_code_sequence_id" position="after">
                    <field
                        name="sequence_choice_field_id"
                        options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"
                        invisible="unique_code_sequence_id"
                    />
                </field>
            </data>
        </field>
    </record>
</odoo>
