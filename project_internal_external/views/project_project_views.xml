<data>
    <record id="project_project_view_form" model="ir.ui.view">
        <field name="name">project.project.view.form.internal_external</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <data>
                <field name="date_start" position="after">
                    <field name="internal_external" groups="project.group_project_manager"/>
                    <field name="internal_external" groups="!project.group_project_manager" readonly="1"/>
                </field>
                <field name="unique_code" position="replace">
                    <field name="unique_code" groups="project.group_project_manager"/>
                    <field name="unique_code" groups="!project.group_project_manager" readonly="1"/>
                </field>
            </data>
        </field>
    </record>
    <record id="project_project_view_tree" model="ir.ui.view">
        <field name="name">project.project.view.tree.internal_external</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="internal_external" optional="hide" />
            </xpath>
        </field>
    </record>
</data>
