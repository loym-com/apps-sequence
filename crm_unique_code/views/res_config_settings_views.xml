<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_crm_unique_code" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.crm.unique_code</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="crm.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//app[@name='crm']" position="inside">
                    <div class="app_settings_block" data-string="Display" string="Display">
                        <h2>Leads Display</h2>
                        <div class="row mt16 o_settings_container">
                            <div>
                                <p>Pattern examples:
                                    <b>5 digits</b>: {id:0>5} -
                                    <b>date</b>: {create_date:%Y-%m-%d} -
                                    <b>related</b>: {related_id.field} -
                                    <b>sequence</b>: {_sequence_}
                                </p>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <field name="ir_model_crm_lead" invisible="1"/>
                                <label
                                    for="crm_lead_display_name_pattern"
                                    string="Computed Lead Name Pattern"
                                />
                                <field
                                    name="crm_lead_display_name_pattern"
                                    class="w-100"
                                    placeholder="{unique_code} - {name}"
                                />
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <field name="ir_model_crm_lead" invisible="1"/>
                                <label
                                    for="crm_lead_unique_code_pattern"
                                    string="Stored Unique Lead No. Pattern"
                                />
                                <field
                                    name="crm_lead_unique_code_pattern"
                                    class="w-100"
                                    placeholder="{_sequence_}"
                                />
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <field name="ir_model_crm_lead" invisible="1"/>
                                <label for="crm_lead_unique_code_sequence_id" string="Lead Sequence"/>
                                <field name="crm_lead_unique_code_sequence_id" class="w-100"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
